+@app.post("/api/mobile/conversations/<int:conversation_id>/profile")
+@mobile_token_required
+def mobile_update_group_profile(conversation_id: int) -> Any:
+    user = mobile_current_user()
+    user_id = int(user["id"])
+    if not is_conversation_member(conversation_id, user_id):
+        return json_error("Group chat not found.", 404)
+    with db_connect() as db:
+        conversation = db_execute(
+            db,
+            """
+            SELECT id, name, conversation_type, profile_picture_url, profile_picture_public_id
+            FROM conversations WHERE id = ?
+            """,
+            (conversation_id,),
+        ).fetchone()
+    if not conversation or str(conversation["conversation_type"]) != "group":
+        return json_error("Only group chats can be edited.")
+    name = str(request.form.get("name", conversation["name"] or "")).strip()
+    if not 1 <= len(name) <= 60:
+        return json_error("Group name must be 1–60 characters.")
+    uploaded = request.files.get("file")
+    remove_picture = str(request.form.get("remove_picture", "")).lower() == "true"
+    old_url = str(conversation["profile_picture_url"] or "")
+    old_public_id = str(conversation["profile_picture_public_id"] or "")
+    picture_url: str | None = old_url or None
+    picture_public_id: str | None = old_public_id or None
+    replace_old = False
+    if uploaded and uploaded.filename:
+        original_name = secure_filename(uploaded.filename)
+        classification = classify_upload(original_name, uploaded.mimetype or "")
+        if not classification or classification[0] != "image":
+            return json_error("Group pictures must be JPG, PNG, GIF, or WEBP.")
+        if USE_CLOUDINARY:
+            try:
+                result = cloudinary.uploader.upload(
+                    uploaded.stream,
+                    resource_type="image",
+                    folder="kulot-friends-chat/groups",
+                    public_id=f"group-{conversation_id}-{uuid.uuid4().hex}",
+                    overwrite=False,
+                    transformation=[{"width": 1024, "height": 1024, "crop": "limit", "quality": "auto"}],
+                )
+                picture_url = str(result.get("secure_url") or "")
+                picture_public_id = str(result.get("public_id") or "") or None
+                if not picture_url:
+                    raise RuntimeError("Cloud media storage did not return a secure URL.")
+            except Exception as exc:
+                app.logger.exception("Mobile group picture upload failed")
+                return json_error(f"Group picture upload failed: {exc}", 502)
+        else:
+            stored_name = f"group-{conversation_id}-{uuid.uuid4().hex}{classification[1]}"
+            uploaded.save(GROUP_UPLOAD_DIR / stored_name)
+            picture_url = url_for("group_uploaded_file", filename=stored_name)
+            picture_public_id = None
+        replace_old = True
+    elif remove_picture:
+        picture_url = None
+        picture_public_id = None
+        replace_old = True
+    with db_connect() as db:
+        db_execute(
+            db,
+            "UPDATE conversations SET name = ?, profile_picture_url = ?, profile_picture_public_id = ? WHERE id = ?",
+            (name, picture_url, picture_public_id, conversation_id),
+        )
+    if replace_old and old_url and (old_url != (picture_url or "") or old_public_id != (picture_public_id or "")):
+        remove_group_picture_file(old_url, old_public_id)
+    payload = conversation_payload(conversation_id, user_id)
+    emit_to_conversation_members("conversation_profile_updated", {"conversation": payload}, conversation_id)
+    return jsonify({"conversation": payload})
+
