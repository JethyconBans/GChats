+@app.post("/api/mobile/conversations/<int:conversation_id>/leave")
+@mobile_token_required
+def mobile_leave_group(conversation_id: int) -> Any:
+    user = mobile_current_user()
+    user_id = int(user["id"])
+    username = str(user["username"])
+    if not is_conversation_member(conversation_id, user_id):
+        return json_error("Group chat not found.", 404)
+    with db_connect() as db:
+        conversation = db_execute(
+            db,
+            "SELECT id, conversation_type, created_by, is_default, profile_picture_url, profile_picture_public_id FROM conversations WHERE id = ?",
+            (conversation_id,),
+        ).fetchone()
+        if not conversation or str(conversation["conversation_type"]) != "group":
+            return json_error("Only group chats can be left.")
+        if bool(conversation["is_default"]):
+            return json_error("You cannot leave the main Kulot Friends group.")
+        db_execute(db, "DELETE FROM conversation_members WHERE conversation_id = ? AND user_id = ?", (conversation_id, user_id))
+        remaining = db_execute(
+            db,
+            "SELECT user_id FROM conversation_members WHERE conversation_id = ? ORDER BY joined_at, user_id",
+            (conversation_id,),
+        ).fetchall()
+        deleted = not remaining
+        if deleted:
+            db_execute(db, "DELETE FROM conversations WHERE id = ?", (conversation_id,))
+        elif int(conversation["created_by"] or 0) == user_id:
+            db_execute(db, "UPDATE conversations SET created_by = ? WHERE id = ?", (int(remaining[0]["user_id"]), conversation_id))
+    if deleted:
+        remove_group_picture_file(str(conversation["profile_picture_url"] or ""), str(conversation["profile_picture_public_id"] or ""))
+    else:
+        emit_to_conversation_members(
+            "conversation_members_updated",
+            {"conversation_id": conversation_id, "left_username": username},
+            conversation_id,
+        )
+    return jsonify({"left": True, "conversation_id": conversation_id, "deleted": deleted})
+
