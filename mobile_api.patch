+@app.patch("/api/mobile/profile")
+@mobile_token_required
+def mobile_update_profile() -> Any:
+    user = mobile_current_user()
+    data = request.get_json(silent=True) or {}
+    fields: list[str] = []
+    params: list[Any] = []
+    if "bio" in data:
+        bio = str(data.get("bio", "")).strip()
+        if len(bio) > 160:
+            return json_error("Bios are limited to 160 characters.")
+        fields.append("bio_text = ?")
+        params.append(bio or None)
+    if "note" in data:
+        note = str(data.get("note", "")).strip()
+        if len(note) > 60:
+            return json_error("Notes are limited to 60 characters.")
+        fields.extend(["note_text = ?", "note_expires_at = ?"])
+        params.extend([
+            note or None,
+            (datetime.now(timezone.utc) + timedelta(hours=24)).isoformat() if note else None,
+        ])
+    if fields:
+        params.append(int(user["id"]))
+        with db_connect() as db:
+            db_execute(db, f"UPDATE users SET {', '.join(fields)} WHERE id = ?", tuple(params))
+    refreshed = user_by_id(int(user["id"]))
+    if not refreshed:
+        return json_error("Could not reload the profile.", 500)
+    profile = profile_payload(refreshed)
+    emit_profile_update(profile)
+    return jsonify({"profile": profile})
