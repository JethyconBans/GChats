+    classification = classify_upload(original_name, uploaded.mimetype or "")
+    if not classification or classification[0] != "image":
+        raise ValueError("Profile pictures must be JPG, PNG, GIF, or WEBP.")
+    extension = classification[1]
+    if USE_CLOUDINARY:
+        result = cloudinary.uploader.upload(
+            uploaded.stream,
+            resource_type="image",
+            folder="kulot-friends-chat/profiles",
+            public_id=f"user-{int(user['id'])}-{uuid.uuid4().hex}",
+            overwrite=False,
+            transformation=[{"width": 720, "height": 720, "crop": "limit", "quality": "auto"}],
+        )
+        url = str(result.get("secure_url") or "")
+        public_id = str(result.get("public_id") or "") or None
+        if not url:
+            raise RuntimeError("Cloud media storage did not return a secure URL.")
+        return url, public_id
+    stored_name = f"profile-{int(user['id'])}-{uuid.uuid4().hex}{extension}"
+    uploaded.save(PROFILE_UPLOAD_DIR / stored_name)
+    return url_for("profile_uploaded_file", filename=stored_name), None
+
