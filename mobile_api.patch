+@app.post("/api/mobile/profile/picture")
+@mobile_token_required
+def mobile_update_profile_picture() -> Any:
+    user = mobile_current_user()
+    uploaded = request.files.get("file")
+    if not uploaded or not uploaded.filename:
+        return json_error("Choose a profile picture first.")
+    if (request.content_length or 0) > PROFILE_MAX_UPLOAD_MB * 1024 * 1024:
+        return json_error(f"Profile pictures are limited to {PROFILE_MAX_UPLOAD_MB} MB.", 413)
+    old_url = str(user["profile_picture_url"] or "")
+    old_public_id = str(user["profile_picture_public_id"] or "")
+    try:
+        picture_url, new_public_id = mobile_store_profile_picture(user, uploaded)
+    except ValueError as exc:
+        return json_error(str(exc))
+    except Exception as exc:
+        app.logger.exception("Mobile profile picture upload failed")
+        return json_error(f"Profile picture upload failed: {exc}", 502)
+    with db_connect() as db:
+        db_execute(
+            db,
+            "UPDATE users SET profile_picture_url = ?, profile_picture_public_id = ? WHERE id = ?",
+            (picture_url, new_public_id, int(user["id"])),
+        )
+    if USE_CLOUDINARY and old_public_id and old_public_id != (new_public_id or ""):
+        try:
+            cloudinary.uploader.destroy(old_public_id, resource_type="image", invalidate=True)
+        except Exception:
+            app.logger.warning("Could not remove old mobile profile picture.")
+    elif old_url.startswith("/profile-uploads/"):
+        (PROFILE_UPLOAD_DIR / old_url.rsplit("/", 1)[-1]).unlink(missing_ok=True)
+    refreshed = user_by_id(int(user["id"]))
+    profile = profile_payload(refreshed) if refreshed else profile_payload(user)
+    emit_profile_update(profile)
+    return jsonify({"profile": profile})
