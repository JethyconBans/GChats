+def mobile_token_hash(raw_token: str) -> str:
+    return hashlib.sha256(raw_token.encode("utf-8")).hexdigest()
+
+
+def parse_utc_datetime(value: Any) -> datetime | None:
+    if not value:
+        return None
+    try:
+        parsed = datetime.fromisoformat(str(value))
+        if parsed.tzinfo is None:
+            parsed = parsed.replace(tzinfo=timezone.utc)
+        return parsed
+    except (TypeError, ValueError):
+        return None
+
+
+def issue_mobile_token(user_id: int, device_name: str = "Android") -> str:
+    raw_token = secrets.token_urlsafe(48)
+    now = datetime.now(timezone.utc)
+    expires_at = now + timedelta(days=MOBILE_TOKEN_DAYS)
+    with db_connect() as db:
+        db_execute(
+            db,
+            "DELETE FROM api_tokens WHERE expires_at < ?",
+            (now.isoformat(),),
+        )
+        db_execute(
+            db,
+            """
+            INSERT INTO api_tokens
+                (user_id, token_hash, created_at, expires_at, last_used_at, device_name)
+            VALUES (?, ?, ?, ?, ?, ?)
+            """,
+            (
+                user_id,
+                mobile_token_hash(raw_token),
+                now.isoformat(),
+                expires_at.isoformat(),
+                now.isoformat(),
+                device_name[:120],
+            ),
+        )
+    return raw_token
+
+
+def mobile_user_from_token(raw_token: str, *, touch: bool = True) -> DbRow | None:
+    if not raw_token or len(raw_token) < 32:
+        return None
+    token_hash = mobile_token_hash(raw_token)
+    with db_connect() as db:
+        row = db_execute(
+            db,
+            """
+            SELECT users.id, users.username, users.password_hash, users.created_at,
+                   users.profile_picture_url, users.profile_picture_public_id,
+                   users.note_text, users.note_expires_at, users.bio_text,
+                   users.last_seen_at, api_tokens.expires_at
+            FROM api_tokens
+            JOIN users ON users.id = api_tokens.user_id
+            WHERE api_tokens.token_hash = ?
+            """,
+            (token_hash,),
+        ).fetchone()
+        if not row:
+            return None
+        expires_at = parse_utc_datetime(row["expires_at"])
+        if not expires_at or expires_at <= datetime.now(timezone.utc):
+            db_execute(db, "DELETE FROM api_tokens WHERE token_hash = ?", (token_hash,))
+            return None
+        if touch:
+            db_execute(
+                db,
+                "UPDATE api_tokens SET last_used_at = ? WHERE token_hash = ?",
+                (utc_now(), token_hash),
+            )
+    return row
+
+
+def mobile_bearer_token() -> str:
+    header = request.headers.get("Authorization", "").strip()
+    if not header.lower().startswith("bearer "):
+        return ""
+    return header[7:].strip()
+
+
+def mobile_token_required(view: F) -> F:
+    @wraps(view)
+    def wrapped(*args: Any, **kwargs: Any) -> Any:
+        raw_token = mobile_bearer_token()
+        user = mobile_user_from_token(raw_token)
+        if not user:
+            return jsonify({"error": "Your login expired. Please sign in again."}), 401
+        g.mobile_user = user
+        g.mobile_token = raw_token
+        touch_last_seen(int(user["id"]))
+        return view(*args, **kwargs)
+
+    return wrapped  # type: ignore[return-value]
+
+
