SECRET_KEY=replace-with-a-long-random-secret
INVITE_CODE=KULOT-FRIENDS-2026
COOKIE_SECURE=false
REMEMBER_DAYS=90
MAX_UPLOAD_MB=25

# Leave blank to use local SQLite. For permanent cloud accounts, paste your
# Neon PostgreSQL connection string here and also add it to Render Environment.
DATABASE_URL=

# Optional but required for permanent pictures and videos on cloud hosting.
# Copy this from your Cloudinary dashboard. Never commit the real value.
CLOUDINARY_URL=

# Number of older messages loaded per page (20-100).
HISTORY_PAGE_SIZE=50

# Android Trusted Web Activity settings. The fingerprint is generated after
# Bubblewrap creates your signing key. Add both values to Render Environment.
ANDROID_PACKAGE_NAME=com.kulot.friends
ANDROID_SHA256_FINGERPRINT=

